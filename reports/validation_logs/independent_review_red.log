    def verify_plan_feasibility(
        network: GridNetwork,
        services: Iterable[ServiceOrder],
        catalog: ResourceCatalog,
        plan: ExecutionPlan,
    ) -> FeasibilityReport:
        """Audita integralmente um plano exportado contra todas as restri��es do problema."""
        services = list(services)
