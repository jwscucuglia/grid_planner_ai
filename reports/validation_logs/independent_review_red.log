        if structural_errors:
            mandatory = [s for s in services if s.mandatory and s.scope_status == 'ACTIVE' and s.created_at_day <= plan.decision_day]
            scheduled = {sid for w in plan.windows for sid in w.service_ids}
            completed = sum(s.service_id in scheduled for s in mandatory)
            return FeasibilityReport(
                plan_id=plan.plan_id, method_name=plan.method_name, scenario_id=plan.scenario_id,
                is_feasible=False, mandatory_portfolio_complete=completed == len(mandatory),
                completed_mandatory_count=completed, total_mandatory_count=len(mandatory),
                violations=structural_errors, isolation_verified=False,
            )
        svc_map: Dict[str, ServiceOrder] = {s.service_id: s for s in services}
        violations: List[str] = []
        warnings: List[str] = []
    
        known_mandatory = [
            s.service_id
            for s in svc_map.values()
            if s.mandatory
            and s.scope_status == "ACTIVE"
            and s.created_at_day <= plan.decision_day
        ]
    
        scheduled_service_occurrences: Dict[str, int] = {}
        service_exec_times: Dict[str, Tuple[int, float, float]] = {}
    
        for win in plan.windows:
            if not win.service_ids:
                violations.append(f"Janela '{win.window_id}' vazia (sem servi�os).")
            for sid in win.service_ids:
                scheduled_service_occurrences[sid] = (
                    scheduled_service_occurrences.get(sid, 0) + 1
                )
    
        for sid, count in scheduled_service_occurrences.items():
            if count > 1:
                violations.append(
                    f"Servi�o '{sid}' programado em duplicidade ({count} vezes)."
                )
            if sid not in svc_map:
                violations.append(
                    f"Servi�o '{sid}' no plano n�o existe no cat�logo da carteira."
